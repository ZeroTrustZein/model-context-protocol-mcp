# MLS listing feed (RESO Web API / Bridge / Trestle compatible)
MLS_API_BASE=https://api.example-mls.com/reso/odata
MLS_API_KEY=
MLS_API_SECRET=
# Optional: bearer token if the provider does not use the client-credentials flow
MLS_API_TOKEN=
# OAuth2 client-credentials endpoint used with MLS_API_KEY / MLS_API_SECRET
MLS_TOKEN_URL=

# Demographic data (US Census ACS)
CENSUS_API_BASE=https://api.census.gov/data
CENSUS_API_KEY=

# Reserved for a future embedding backend (pgvector / qdrant); not used yet
VECTOR_STORE_URL=
VECTOR_STORE_COLLECTION=property_listings
EMBEDDING_MODEL=text-embedding-3-small

# Runtime
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
CACHE_TTL_SECONDS=300
